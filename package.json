{
  "name": "ai-desktop-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:server": "python -m uvicorn app.main:app --app-dir apps/server --reload --host 127.0.0.1 --port 8000",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:full": "cmd /c \"start cmd /k pnpm dev:server && start cmd /k pnpm dev:web\"",
    "lint:web": "pnpm --dir apps/web lint"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  }
}
